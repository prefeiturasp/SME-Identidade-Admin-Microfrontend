# Prefixo de rota sob o qual a aplicação é servida atrás do nginx.
# Default "/admin" (usado em QA/produção, onde http://.../admin -> este
# container). Defina como vazio para rodar sem prefixo (ex.: acessar
# localhost:3001/dashboard direto em vez de localhost:3001/admin/dashboard).
# NEXT_BASE_PATH=/admin

# URL base do SSO-Microsservico (identidade-sso)
SSO_MS_URL=

# API Key de sistema usada para autenticar o BFF do Next.js contra o SSO-MS.
# Nunca expor com prefixo NEXT_PUBLIC_ - uso exclusivo server-side.
SSO_MS_API_KEY=
